# ============================================================
# 背记系统 .gitignore
# ⚠️ 密钥类文件（.env / asr.yaml）绝不入库，只保留 *.example.*
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 运行时数据（不入库）----------
backend/data/
backend/backups/
*.db
*.db-wal
*.db-shm

# ---------- 运行日志与临时产物（可再生成，不入库）----------
# ⚠️ 只排除 *.log（应用运行日志，每次运行都变、且会无限增长）；
#    烟测**结论**是 smoke_*.txt，保留入库当验收证据。
*.log
backend/.smoketmp/
qa/tmp/
# 管理端构建产物（由 admin-web/dist 部署复制而来，可再生成）
backend/static/
# 排障时保留的原文件备份
*.orig
# 手动抓的临时 logcat
qa/tmp_logcat_*.txt

# ⚠️ 但 `admin-web/logs/` 是个例外，要整个排除：
#    它是**烟测脚本自己 `writeFileSync` 覆盖写的运行日志**（每次跑都变），
#    与 `qa/smoke_*.txt`（**人工存档**的结论快照，写完不再变）性质不同。
#    留着会让「跑一次烟测 → 工作区就脏」。证据一律存 `qa/`。
admin-web/logs/

# ---------- 密钥与本地配置（硬红线）----------
.env
.env.*
.env.local
asr.yaml
backend/.env
backend/asr.yaml

# 模板必须保留
!backend/.env.example
!backend/asr.example.yaml
!*.example.yaml
# 管理端开发配置——文件自述「随仓库提交，不含任何密钥」且经人工核对属实，
# 是**唯一**允许入库的 .env.*；其余（如 .env.production/.env.local）一律拦下。
!admin-web/.env.development

# ---------- Node / 管理端 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---------- Flutter / 学生端 ----------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.iml
.gradle/
student-app/android/local.properties
student-app/.packages
# flutter config 写出的本地文件含本机绝对路径，不该入库
.flutter_settings
# flutter/dart 工具的本地状态（每台机器不同），不入库
.flutter_tool_state

# ---------- IDE ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- OS ----------
Thumbs.db
Desktop.ini
.DS_Store
release/

# 本地化模型文件（localize-dev，300MB+ 不入库）
backend/models/

# 构建产物与探测临时产物（不入库）
admin-web/dist-deploy/
backend/qa/

# 真机上行音频 dump（排障产物，可再生成，不入库）
qa/_app_uplink_*.wav
# 会话临时产物
_restart_log.txt
.workbuddy/*.png
.workbuddy/tmp_*.txt
.workbuddy/ui.xml
# 管理端构建产物（web11 部署包，可再生成）
admin-web/dist-web11/
apk-out/
