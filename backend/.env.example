# ============================================================
# 背记系统 后端环境变量模板
#
# 用法：复制本文件为 .env 后按需修改。** .env 不入版本库 **
# 契约依据：docs/dev/01-共享契约冻结.md §9.1
# ============================================================

# ---- 服务 ----
APP_HOST=0.0.0.0
# 服务端口固定 8810（契约 §11）
# ⚠️ 不要改成 9010 / 8080 / 1935 / 8554 / 8889 / 8890 —— 本机这些端口已被直播课堂等占用
APP_PORT=8810

# ---- 数据库 ----
# 相对 backend/ 目录；SQLite 单文件
DB_PATH=./data/bjsys.db
# 每日 02:00 VACUUM INTO 备份目录
BACKUP_DIR=./backups

# ---- 鉴权 ----
# ⚠️ 首次部署必须替换。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_chars
# Token 有效期（小时）。学生端设备长期使用，默认 12
JWT_TTL_HOURS=12

# ---- 日志 ----
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---- 初始管理者账号 ----
# 首次启动且 users 表无 admin 时自动创建；登录后请立即改密码
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=CHANGE_ME_admin_password

# ---- CORS ----
# 管理端开发服务器来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173
