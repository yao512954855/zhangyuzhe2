# ============================================================
# 语音（ASR）配置模板 —— 契约《01-共享契约冻结》§9.2 + WP-BE-06
#
# 用法：copy asr.yaml.example asr.yaml，然后填 api_key。
# ⚠️ 本文件**可以入库**；真正的 `asr.yaml` 已在 .gitignore 中排除（含密钥）。
# ⚠️ 安全红线：AccessKey 只存在于服务端 asr.yaml，**绝不进入 APK / 前端代码 / 数据库**。
#
# 没有云账号也能开发：把 provider 改成 "mock"（见文件末尾 mock 段），
# 或设环境变量 ASR_CONFIG_PATH 指向另一份 yaml。
# ============================================================

provider: aliyun          # aliyun | volcengine | mock
backup_provider: ""       # 非空则启用主备切换（主厂商建连失败 / 连续 3 次错误 → 切备）

aliyun:
  api_key: ""             # 百炼（DashScope）凭证；留空则 asr_ready=false

  # ⚠️ 本项目账号下 Paraformer / SenseVoice 全系不可用。
  # 2026-09-23 选型实测（依据 qa/ASR模型选型报告.md）：**按场景双模型**
  streaming_model: "qwen-audio-3.1-asr-flash-streaming"   # 语文背诵（流式）：首字 340–354ms
  batch_model: "fun-asr-flash-2026-06-15"                 # 英语说词/拼读（非流式）：忠实，P50 323ms
  verify_model: "qwen-audio-3.0-asr-flash"                # 拼读交叉校验（可选）

  # ⛔ 禁用清单：qwen3-asr-flash —— 会把学生错读「脑补」成正确词（GLASS→CLASS、ABPLE→APPLE），
  #    用于判分等于放过错读，属教学事故（选型报告 §1.2）。
  #    BE-06 在 AliyunProvider.start_session 里做了**硬拦截**，配错会直接报错而不是静默使用。

  ws_endpoint: "wss://dashscope.aliyuncs.com/api-ws/v1/inference"
  http_endpoint: "https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
  http_format: "wav"      # ⚠️ HTTP 调用必须显式传 parameters.format，否则 UNSUPPORTED_FORMAT

volcengine:
  app_id: ""
  access_token: ""
  model: "doubao-streaming-asr"
  endpoint: ""            # 留空则 start_session 明确报「配置不完整」，不会静默返回空

# 语种映射：**由服务端按 task_type 决定，不信任客户端传入的 lang_hint**（契约 §6.3）
lang_map:
  word: "en"              # 说单词：要英语语言先验
  spell: "zh"             # ⚠️ 拼读用 zh！en 会把字母串拼成单词（实测 85% → 95%）
  zh_answer: "zh"
  recite: "zh"

hotwords:
  enabled: false          # 预研实测无效（qa/ASR预研报告.md §4.2），一期不启用
  sources: []             # 保留配置位，换厂商后可重新验证

# 多模态仲裁：专用 ASR 判不准时的「第二判据」（需求 §9.7，一期启用）
arbitrator:
  enabled: true           # ← 预研已确认启用（与 ASR 互补而非包含）
  provider: "aliyun"
  model: "qwen3.5-omni-plus"          # 默认多模态；改 qwen-audio-3.0-asr-flash = 第二个 ASR（更快更便宜）
  api_key: ""             # 留空则回落到 aliyun.api_key
  endpoint: ""            # 留空则回落到 aliyun.http_endpoint
  buffer_ms: 15000        # 只为仲裁在**内存**里保留最近这么久音频（F18：仍然不落盘）
  trigger: [empty, fuzzy, appeal]     # 严禁进主链路（延迟秒级、按 token 计费）

# 多模态兜底判定：专用 ASR **整段失败 / 低置信**时的最后一次识别机会（WP-2C，二期）
# 与 arbitrator 的区别：arbitrator 管「判分结果级」（empty/fuzzy/申诉）；
# fallback 管「ASR 链路级」（失败 / 低置信）—— 在降级键盘之前再试一次。
# ⚠️ 同样严禁进主链路：一次干净的高置信结果绝不触发兜底。
fallback:
  enabled: false          # ← 默认关闭；接好 key 且确认模型后再开（按 token 计费、秒级延迟）
  provider: "aliyun"
  model: "qwen3.5-omni-plus"          # 多模态兜底；不要用 qwen-audio-3.0-asr-flash 之外的脑补模型
  api_key: ""             # 留空则回落到 aliyun.api_key
  endpoint: ""            # 留空则回落到 aliyun.http_endpoint
  http_format: "wav"      # 复用 aliyun.http_format（HTTP 调用必须显式传 format）
  confidence_threshold: 0.5   # ASR 置信度低于此值才触发（配置驱动，不硬编码）
  timeout_ms: 5000
  trigger_on_error: true          # ASR 抛错 / 超时 → 触发兜底
  trigger_on_low_confidence: true # 低置信 → 触发兜底
  # ⛔ 禁用清单（配置即报错，不静默使用）：qwen3-asr-flash / qwen3-asr-flash-realtime
  #    —— 会把学生错读脑补成正确词（GLASS→CLASS、ABPLE→APPLE），用于判分属教学事故。
  # 提示词固定、且**不含答案文本**，确保 expected 永不下发云厂商（契约 §6.3 红线）。

limits:
  connect_timeout_ms: 3000
  chunk_ms: 150
  max_session_seconds: 300
  # ---- BE-06 补充的运行时编排参数（契约未列，但接口设计 §11 有此约束）----
  max_connections: 60     # 全局 WebSocket 上限（接口设计 §11）
  queue_size: 120         # 排队长度（接口设计 §11）
  queue_wait_ms: 5000     # 排队超 5 秒 → 50001
  heartbeat_timeout_s: 60 # 60s 未收到消息主动关闭（契约 §6.2）
  failover_threshold: 3   # 连续失败 N 次 → 粘性切备厂商（F5）

# ---- 离线联调（F4）：无云账号时把 provider 改成 mock ----
# 有了它，APP-02/03/04 不等云账号也能跑通完整流程。
mock:
  behavior: normal        # normal | empty | timeout | error | connect_fail
  fail_times: 0           # 前 N 次会话直接失败（测 U8 连续错误 / U9 主备切换）
  final_text: "classroom"
  partial_script: []      # 显式指定累计 partial 文本；空则按 final_text 自动切分
  confidence: 0.95
  partial_every: 1        # 每 N 片音频产出一个 partial
  by_task: {}             # 按 task_type 覆盖，如 {spell: {final_text: "see ell aye ess ess"}}
